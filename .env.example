NODE_ENV=development
PORT=3000

# Valores do docker-compose.yml
DATABASE_URL=postgresql://docker:docker@localhost:5432/webhookrelay
REDIS_URL=redis://localhost:6379

# Segredo usado para assinar (HMAC-SHA256) cada entrega
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=change-me

# Opcional: tempo máximo de espera pela resposta do destino (ms)
DELIVERY_TIMEOUT_MS=10000
