{
  "name": "webhookrelay",
  "version": "1.0.0",
  "description": "Reliable webhook delivery service: idempotent ingestion, queue-based delivery with retries and exponential backoff",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Tiago Silvino",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "7.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "bullmq": "^6.4.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
